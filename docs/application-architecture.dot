digraph application_architecture {
    graph [
        bgcolor="white"
        pad="0.20"
        nodesep="0.40"
        ranksep="0.55"
        rankdir=LR
        splines=polyline
        newrank=true
        fontname="Helvetica"
        labelloc="t"
        label="PDF extraction application — request architecture"
        fontsize=16
        fontcolor="#172033"
    ]

    node [
        fontname="Helvetica"
        fontsize=10
        fontcolor="#172033"
        color="#8090aa"
        penwidth=1.2
        style="filled"
        fillcolor="#f7f9fc"
        margin="0.16,0.10"
    ]

    edge [
        fontname="Helvetica"
        fontsize=9
        fontcolor="#53627a"
        color="#8090aa"
        arrowsize=0.7
    ]

    user [label="User", shape=ellipse, fillcolor="#eef2ff"]
    upload [label="UI\nupload + configure", shape=box, style="rounded,filled", fillcolor="#e9f3ff"]
    api [label="FastAPI\nvalidate + orchestrate", shape=box, style="rounded,filled", fillcolor="#e9f3ff"]
    parse [label="LiteParse + Docling\nhybrid PDF parser", shape=box, style="rounded,filled", fillcolor="#f7f9fc"]
    source [label="Markdown +\ntable", shape=parallelogram, fillcolor="#edf8f1"]
    mode [label="Extraction\nmode", shape=diamond, fillcolor="#fff5d9"]
    automatic [label="Automatic extraction\nDeterministic mapper", shape=box, style="rounded,filled", fillcolor="#edf8f1"]
    schema [label="Schema extraction\nCompact evidence + OpenRouter\nSource validation", shape=box, style="rounded,filled", fillcolor="#f2ecff"]
    output [label="JSON + CSV\nresponse", shape=parallelogram, fillcolor="#edf8f1"]
    review [label="Next.js results UI\nreview + export", shape=box, style="rounded,filled", fillcolor="#e9f3ff"]

    user -> upload [label="uploads"]
    upload -> api [label="request"]
    api -> parse [label="valid PDF"]
    parse -> source [label="text + geometry"]
    source -> mode [label="selects"]
    mode -> automatic [label="automatic"]
    mode -> schema [label="schema"]
    automatic -> output [label="mapped result"]
    schema -> output [label="mapped result"]
    output -> review [label="renders + downloads"]

    { rank=same; automatic; schema }
}
